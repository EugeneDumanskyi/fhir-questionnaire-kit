# Exact versions: ADR-0008 and A3 require @fhirq/* lockstep at exact versions,
# and a reproducible dev toolchain is part of the evidence (NFR-M-04).
save-exact=true
# No implicit hoisting: a package may only import what it declares, which is
# what the dependency gate (NFR-S-01) will later assert mechanically.
hoist=false
strict-peer-dependencies=true
