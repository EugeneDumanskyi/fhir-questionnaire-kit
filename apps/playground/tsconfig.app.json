{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    /* Vite's client types: `?raw` imports and stylesheet side-effect imports. */
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": ".tsbuild/app"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "references": [{ "path": "../../packages/core" }, { "path": "../../packages/react" }]
}
