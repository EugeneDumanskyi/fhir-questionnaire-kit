{
  "name": "fhir-questionnaire-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for @fhirq/*: render a FHIR R4 Questionnaire, emit a valid QuestionnaireResponse",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @fhirq/playground dev",
    "typecheck": "tsc --build --force tsconfig.json && tsc -p tests/browser",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "measure": "node scripts/measure-bundles.mjs",
    "changeset": "changeset",
    "clean": "tsc --build --clean tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@changesets/cli": "2.31.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@vitest/coverage-v8": "3.2.7",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "3.2.7"
  }
}
