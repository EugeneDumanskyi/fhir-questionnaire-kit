{
  "resourceType": "Questionnaire",
  "url": "urn:fhirq:conformance:enablewhen-text",
  "version": "1",
  "status": "draft",
  "title": "enableWhen operators on text",
  "item": [
    {
      "linkId": "q",
      "text": "A text question",
      "type": "text"
    },
    {
      "linkId": "eq",
      "text": "Shown when q =",
      "type": "display",
      "enableWhen": [
        {
          "question": "q",
          "operator": "=",
          "answerString": "twice a day"
        }
      ]
    },
    {
      "linkId": "ne",
      "text": "Shown when q !=",
      "type": "display",
      "enableWhen": [
        {
          "question": "q",
          "operator": "!=",
          "answerString": "twice a day"
        }
      ]
    },
    {
      "linkId": "exists",
      "text": "Shown when q exists",
      "type": "display",
      "enableWhen": [
        {
          "question": "q",
          "operator": "exists",
          "answerBoolean": true
        }
      ]
    }
  ]
}
