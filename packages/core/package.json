{
  "name": "@fhirq/core",
  "version": "0.0.0",
  "description": "DOM-free engine and presentation model for FHIR R4 Questionnaire forms",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./view": {
      "import": {
        "types": "./dist/view/index.d.ts",
        "default": "./dist/view/index.js"
      },
      "require": {
        "types": "./dist/view/index.d.cts",
        "default": "./dist/view/index.cjs"
      }
    },
    "./resume": {
      "import": {
        "types": "./dist/resume.d.ts",
        "default": "./dist/resume.js"
      },
      "require": {
        "types": "./dist/resume.d.cts",
        "default": "./dist/resume.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "!dist/**/*.map", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "typecheck": "tsc --build --force"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
