{
  "name": "@fhirq/themes",
  "version": "0.0.0",
  "description": "Structural stylesheet and token presets for the FHIR Questionnaire Kit",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": ["*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./base.css": "./dist/base.css",
    "./default.css": "./dist/default.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "LICENSE", "NOTICE"],
  "scripts": {
    "typecheck": "tsc --build --force"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
