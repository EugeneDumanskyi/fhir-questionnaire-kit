{
  "name": "@fhirq/themes",
  "version": "0.0.0",
  "description": "Structural stylesheet and token presets for the FHIR Questionnaire Kit",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./base.css": "./dist/base.css",
    "./default.css": "./dist/default.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "!dist/**/*.map", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "typecheck": "tsc --build --force"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
